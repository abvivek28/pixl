# Deployed backend origin (scheme + host only; do not append /api).
# Leave blank for local development, where Vite proxies /api to FastAPI.
VITE_API_BASE_URL=

# Local FastAPI origin used by the Vite development proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Production example:
# VITE_API_BASE_URL=https://your-backend.onrender.com
