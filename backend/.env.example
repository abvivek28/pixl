# Browser origins allowed to call this API (comma-separated, no trailing slash).
# Add your deployed Vercel URL, e.g. https://your-project.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-project.vercel.app

# Cloudflare Workers AI — FLUX.2 [klein] 4B
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KLEIN_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_FLUX_SCHNELL_MODEL=@cf/black-forest-labs/flux-1-schnell

# Meta Muse Spark 1.3 Contributor planning (Contributor mode allows Meta to use submitted prompts/responses to improve its models)
MODEL_API_KEY=
META_MODEL=muse-spark-1.3-contributor

# Optional provider cache / resilience settings
PIXL_PROVIDER_CACHE_DIR=data/provider_cache
PIXL_PROVIDER_TIMEOUT_SECONDS=90
PIXL_PROVIDER_RETRIES=3
PIXL_GENERATION_TIMEOUT_SECONDS=120
# Optional FLUX.2 Klein prompt adherence. Tune experimentally; higher is not always better.
CLOUDFLARE_GUIDANCE=4.0

# Registration / crop quality defaults are implemented in the engine:
# 40px context, 30px translation budget, 0.80x–1.20x scale, 768px model input max side.
