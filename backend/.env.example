# Cloudflare Workers AI — FLUX.2 [klein] 4B
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_KLEIN_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_FLUX_SCHNELL_MODEL=@cf/black-forest-labs/flux-1-schnell

# Meta Muse Spark 1.3 Contributor planning (Contributor mode allows Meta to use submitted prompts/responses to improve its models)
MODEL_API_KEY=
META_MODEL=muse-spark-1.3-contributor

# Optional provider cache / resilience settings
PIXL_PROVIDER_CACHE_DIR=data/provider_cache
PIXL_PROVIDER_TIMEOUT_SECONDS=90
PIXL_PROVIDER_RETRIES=3
PIXL_GENERATION_TIMEOUT_SECONDS=120
